enum SkillType {
  PROGRAMMING_LANGUAGE
  FRONTEND
  BACKEND
  DATABASE
  DEVOPS
  CLOUD
  FRAMEWORK
  TOOL
  SOFT_SKILL
  OTHER
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}


model StudentProfile {
  id             String   @id @default(uuid())

  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  studentId      String?  @unique
  phone          String?

  college        String?
  degree         String?
  branch         String?
  graduationYear Int?

  cgpa           Float?
  backlogs       Int      @default(0)

  resumeUrl      String?
  resumeText     String?

  linkedinUrl    String?
  githubUrl      String?
  portfolioUrl   String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  skills         StudentSkill[]
  education      Education[]
  projects       Project[]
  assessments    AssessmentResult[]
  readiness      ReadinessResult[]

  applications   Application[]

  @@index([college])
  @@index([branch])
  @@index([graduationYear])
   @@map("student_profile")
}

model Skill {
  id          String    @id @default(uuid())

  name        String    @unique
  normalized  String    @unique
  type        SkillType

  description String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  students    StudentSkill[]
  jobs        JobSkill[]
  projects    ProjectSkill[]
   @@map("skill")
}

model StudentSkill {
  id        String      @id @default(uuid())

  studentId String
  student   StudentProfile @relation(fields: [studentId],references: [id],onDelete: Cascade)

  skillId   String
  skill     Skill @relation(fields: [skillId],references: [id],onDelete: Cascade)

  level     SkillLevel @default(BEGINNER)
  years     Float?
  source    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, skillId])
  @@index([studentId])
  @@index([skillId])
   @@map("student_skill")
}

model Education {
  id          String   @id @default(uuid())

  studentId   String
  student     StudentProfile @relation(fields: [studentId],references: [id],onDelete: Cascade)

  institution String
  degree      String?
  branch      String?

  startYear   Int?
  endYear     Int?

  cgpa        Float?
  percentage  Float?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([studentId])
   @@map("education")
}

model Project {
  id          String   @id @default(uuid())

  studentId   String
  student     StudentProfile @relation(fields: [studentId],references: [id],onDelete: Cascade)

  title       String
  description String?

  githubUrl   String?
  liveUrl     String?

  startDate   DateTime?
  endDate     DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  skills      ProjectSkill[]

  @@index([studentId])
   @@map("project")
}

model ProjectSkill {
  id        String @id @default(uuid())

  projectId String
  project   Project @relation(fields: [projectId],references: [id],onDelete: Cascade)

  skillId   String
  skill     Skill @relation(fields: [skillId],references: [id],onDelete: Cascade)


  @@unique([projectId, skillId])
   @@map("project_skill")
}