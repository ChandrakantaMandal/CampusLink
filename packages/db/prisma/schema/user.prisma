enum SkillType {
  PROGRAMMING_LANGUAGE
  FRONTEND
  BACKEND
  DATABASE
  DEVOPS
  CLOUD
  FRAMEWORK
  TOOL
  SOFT_SKILL
  OTHER
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

model StudentProfile {
  id                 String              @id @default(uuid())

  userId             String              @unique
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  studentId          String?             @unique
  rollNo             String?
  firstName          String?
  lastName           String?
  phone              String?

  dateOfBirth        DateTime?
  gender             String?

  college            String?
  degree             String?
  branch             String?
  department         String?
  graduationYear     Int?

  cgpa               Float?
  backlogs           Int                 @default(0)

  bio                String?
  location           String?
  targetRole         String?
  isPublic           Boolean             @default(true)
  isVerified         Boolean             @default(false)

  readinessScore     Float?
  readinessLabel     String?

  resumeUrl          String?
  resumeText         String?

  linkedinUrl        String?
  githubUrl          String?
  portfolioUrl       String?
  leetcodeUrl        String?
  hackerrankUrl      String?
  otherWebsiteUrl    String?

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  skills             StudentSkill[]
  education          Education[]
  projects           Project[]
  certifications     Certification[]
  resumes            StudentResume[]
  assessments        AssessmentResult[]
  readiness          ReadinessResult[]
  applications       Application[]
  driveRegistrations DriveRegistration[]
  interviews         Interview[]
  offers             Offer[]

  @@index([college])
  @@index([branch])
  @@index([department])
  @@index([graduationYear])
  @@index([cgpa])
  @@map("student_profile")
}

model Skill {
  id          String         @id @default(uuid())

  name        String         @unique
  normalized  String         @unique
  type        SkillType

  description String?

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  students    StudentSkill[]
  jobs        JobSkill[]
  projects    ProjectSkill[]

  @@index([type])
  @@map("skill")
}

model StudentSkill {
  id        String         @id @default(uuid())

  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  skillId   String
  skill     Skill          @relation(fields: [skillId], references: [id], onDelete: Cascade)

  level     SkillLevel     @default(BEGINNER)
  years     Float?
  source    String?

  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([studentId, skillId])
  @@index([studentId])
  @@index([skillId])
  @@map("student_skill")
}

model Education {
  id          String         @id @default(uuid())

  studentId   String
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  institution String
  degree      String?
  branch      String?

  startYear   Int?
  endYear     Int?

  cgpa        Float?
  percentage  Float?
  description String?

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([studentId])
  @@map("education")
}

model Project {
  id          String         @id @default(uuid())

  studentId   String
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  title       String
  description String?

  githubUrl   String?
  liveUrl     String?

  startDate   DateTime?
  endDate     DateTime?

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  skills      ProjectSkill[]

  @@index([studentId])
  @@map("project")
}

model ProjectSkill {
  id        String  @id @default(uuid())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  skillId   String
  skill     Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([projectId, skillId])
  @@index([projectId])
  @@index([skillId])
  @@map("project_skill")
}

model Certification {
  id             String         @id @default(uuid())

  studentId      String
  student        StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  name           String
  issuingOrg     String
  issueDate      DateTime?
  expiryDate     DateTime?
  credentialId   String?
  certificateUrl String?

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([studentId])
  @@map("certification")
}

model StudentResume {
  id         String         @id @default(uuid())

  studentId  String
  student    StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  fileName   String
  fileSize   String?
  fileUrl    String
  parsedText String?
  isPrimary  Boolean        @default(true)

  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([studentId])
  @@map("student_resume")
}