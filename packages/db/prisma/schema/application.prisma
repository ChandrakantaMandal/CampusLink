enum ApplicationStatus {
  APPLIED
  UNDER_REVIEW
  SHORTLISTED
  ASSESSMENT
  INTERVIEW
  SELECTED
  OFFER_EXTENDED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

model Application {
  id          String            @id @default(uuid())

  studentId   String
  student     StudentProfile    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  jobId       String
  job         Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)

  status      ApplicationStatus @default(APPLIED)

  coverLetter String?
  resumeUrl   String?
  notes       String?

  appliedAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  matchResult MatchResult?
  interviews  Interview[]
  offer       Offer?

  @@unique([studentId, jobId])
  @@index([studentId])
  @@index([jobId])
  @@index([status])
  @@map("application")
}

model MatchResult {
  id              String      @id @default(uuid())

  applicationId   String      @unique
  application     Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  eligible        Boolean
  matchScore      Float

  skillMatchScore Float?
  projectScore    Float?
  experienceScore Float?
  assessmentScore Float?

  matchedSkills   Json?
  missingSkills   Json?
  positiveSignals Json?
  gaps            Json?

  explanation     String?

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@map("match_result")
}

enum AssessmentType {
  TECHNICAL
  APTITUDE
  CODING
  INTERVIEW
  COMMUNICATION
  OTHER
}

model Assessment {
  id              String             @id @default(uuid())

  title           String
  description     String?

  type            AssessmentType

  durationMinutes Int?
  totalQuestions  Int?
  passingScore    Float?
  maxScore        Float?

  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  results         AssessmentResult[]

  @@map("assessment")
}

model AssessmentResult {
  id           String         @id @default(uuid())

  assessmentId String
  assessment   Assessment     @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  studentId    String
  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  score        Float?
  percentage   Float?
  passed       Boolean?

  feedback     String?
  answers      Json?

  takenAt      DateTime       @default(now())

  @@index([studentId])
  @@index([assessmentId])
  @@map("assessment_result")
}

model ReadinessResult {
  id                 String         @id @default(uuid())

  studentId          String
  student            StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  overallScore       Float

  academicScore      Float?
  technicalScore     Float?
  projectScore       Float?
  resumeScore        Float?
  assessmentScore    Float?
  communicationScore Float?

  breakdown          Json?
  weights            Json?

  explanation        String?

  createdAt          DateTime       @default(now())

  @@index([studentId])
  @@map("readiness_result")
}

enum AIAnalysisType {
  RESUME
  SKILL_EXTRACTION
  JOB_ANALYSIS
  MATCHING
  SKILL_GAP
  READINESS
  RECOMMENDATION
  CHAT
  INTERVIEW_PREP
}

enum AIAnalysisStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model AIAnalysis {
  id        String           @id @default(uuid())

  userId    String?
  user      User?            @relation(fields: [userId], references: [id], onDelete: SetNull)

  jobId     String?
  job       Job?             @relation(fields: [jobId], references: [id], onDelete: SetNull)

  type      AIAnalysisType
  status    AIAnalysisStatus @default(PENDING)

  input     Json?
  output    Json?

  model     String?
  provider  String?
  error     String?

  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([userId])
  @@index([jobId])
  @@index([type])
  @@index([status])
  @@map("ai_anaysis")
}

enum RecommendationType {
  SKILL
  PROJECT
  INTERVIEW
  RESUME
  LEARNING
  JOB
  ASSESSMENT
  OTHER
}

model Recommendation {
  id          String             @id @default(uuid())

  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  type        RecommendationType

  title       String
  description String?

  priority    Int                @default(1)

  skillId     String?
  targetJobId String?

  metadata    Json?

  completed   Boolean            @default(false)

  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([userId])
  @@index([type])
  @@map("recommendation")
}
