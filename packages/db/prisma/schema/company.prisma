enum CompanyTier {
  TIER_1
  TIER_2
  TIER_3
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  NOT_VERIFIED
}

model Company {
  id             String             @id @default(uuid())

  name           String
  slug           String?            @unique
  description    String?

  website        String?
  logoUrl        String?

  industry       String?
  location       String?
  linkedinUrl    String?

  tier           CompanyTier        @default(TIER_3)
  verifiedStatus VerificationStatus @default(NOT_VERIFIED)
  benefits       String[]           @default([])

  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  recruiters     RecruiterProfile[]
  jobs           Job[]
  drives         PlacementDrive[]
  offers         Offer[]

  @@index([name])
  @@index([industry])
  @@index([tier])
  @@index([verifiedStatus])
  @@map("company")
}

model RecruiterProfile {
  id              String      @id @default(uuid())

  userId          String      @unique
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyId       String
  company         Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)

  designation     String?
  phone           String?
  linkedinUrl     String?
  isLeadRecruiter Boolean     @default(false)

  notificationPrefs Json?

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  jobs            Job[]
  interviews      Interview[]
  notifications   RecruiterNotification[]

  @@index([companyId])
  @@map("recruiter_profile")
}