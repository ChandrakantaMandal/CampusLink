enum JobStatus {
  DRAFT
  PUBLISHED
  APPLICATIONS_OPEN
  APPLICATIONS_CLOSED
  INTERVIEWING
  COMPLETED
  ARCHIVED
}

model Job {
  id                  String             @id @default(uuid())

  companyId           String
  company             Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)

  recruiterId         String?
  recruiter           RecruiterProfile?  @relation(fields: [recruiterId], references: [id], onDelete: SetNull)

  driveId             String?
  drive               PlacementDrive?    @relation(fields: [driveId], references: [id], onDelete: SetNull)

  title               String
  description         String

  location            String?
  employmentType      String?
  workMode            String?

  ctc                 String?
  openPositions       Int                @default(1)

  minCGPA             Float?
  maxBacklogs         Int?

  requiredDegree      String?
  requiredBranch      String?
  allowedBranches     String[]           @default([])
  graduationYear      Int?

  minExperience       Int?
  maxExperience       Int?

  applicationDeadline DateTime?
  status              JobStatus          @default(APPLICATIONS_OPEN)

  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  skills              JobSkill[]
  rounds              JobRound[]
  applications        Application[]
  aiAnalyses          AIAnalysis[]
  interviews          Interview[]
  offers              Offer[]

  @@index([companyId])
  @@index([recruiterId])
  @@index([driveId])
  @@index([title])
  @@index([status])
  @@map("job")
}

model JobSkill {
  id        String   @id @default(uuid())

  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  skillId   String
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  required  Boolean  @default(true)
  weight    Float    @default(1)

  createdAt DateTime @default(now())

  @@unique([jobId, skillId])
  @@index([jobId])
  @@index([skillId])
  @@map("job_skill")
}

model JobRound {
  id          String   @id @default(uuid())

  jobId       String
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  roundNumber Int
  name        String
  type        String
  description String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([jobId, roundNumber])
  @@index([jobId])
  @@map("job_round")
}