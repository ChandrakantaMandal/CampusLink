{
  "name": "HireBridge",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "pnpm -r dev",
    "build": "pnpm -r --if-present build",
    "check-types": "pnpm -r check-types",
    "dev:web": "pnpm --filter web dev",
    "dev:server": "pnpm --filter server dev",
    "db:push": "pnpm --filter @HireBridge/db db:push",
    "db:studio": "pnpm --filter @HireBridge/db db:studio",
    "db:generate": "pnpm --filter @HireBridge/db db:generate",
    "db:migrate": "pnpm --filter @HireBridge/db db:migrate",
    "db:start": "docker compose up -d postgres",
    "db:watch": "docker compose up postgres",
    "db:stop": "docker compose stop postgres",
    "db:down": "docker compose down postgres",
    "docker:build": "docker compose build",
    "redis:start": "docker compose up -d redis",
    "redis:watch": "docker compose up redis",
    "redis:stop": "docker compose stop redis",
    "redis:down": "docker compose down redis",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/ && varlock codegen --path ./packages/redis/",
    "postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/ && varlock codegen --path ./packages/redis/",
    "auth:generate": "cd apps/server && pnpm run auth:generate",
    "prepare": "husky",
    "test": "pnpm run test:server && pnpm run test:web && pnpm run test:auth && pnpm run test:db",
    "test:watch": "vitest",
    "test:server": "vitest run --config vitest/vitest.server.config.ts",
    "test:web": "vitest run --config vitest/vitest.web.config.ts",
    "test:auth": "vitest run --config vitest/vitest.auth.config.ts",
    "test:db": "vitest run --config vitest/vitest.db.config.ts",
    "test:coverage": "pnpm run test:coverage:server && pnpm run test:coverage:web && pnpm run test:coverage:auth && pnpm run test:coverage:db",
    "test:coverage:server": "vitest run --config vitest/vitest.server.config.ts --coverage",
    "test:coverage:web": "vitest run --config vitest/vitest.web.config.ts --coverage",
    "test:coverage:auth": "vitest run --config vitest/vitest.auth.config.ts --coverage",
    "test:coverage:db": "vitest run --config vitest/vitest.db.config.ts --coverage"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@HireBridge/config": "workspace:*",
    "@types/node": "catalog:",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "supertest": "^7.2.2",
    "typescript": "catalog:",
    "varlock": "catalog:",
    "vitest": "^5.0.1"
  },
  "lint-staged": {
    "**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx,vue,astro,svelte}": ""
  },
  "packageManager": "pnpm@12.4.2"
}
