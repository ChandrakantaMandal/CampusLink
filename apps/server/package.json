{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "compile": "bun build --compile --no-compile-autoload-dotenv --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.mjs",
    "env:generate": "varlock codegen",
    "auth:generate": "varlock run -- pnpm dlx auth@latest generate --config src/services.ts --output ../../packages/db/prisma/schema/auth.prisma --yes"
  },
  "dependencies": {
    "@HireBridge/auth": "workspace:*",
    "@HireBridge/db": "workspace:*",
    "@HireBridge/redis": "workspace:*",
    "@ai-sdk/devtools": "^1.0.15",
    "@ai-sdk/google": "^4.0.64",
    "ai": "catalog:",
    "bcrypt": "^6.0.0",
    "better-auth": "catalog:",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "varlock": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@HireBridge/config": "workspace:*",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.13",
    "typescript": "catalog:"
  }
}
